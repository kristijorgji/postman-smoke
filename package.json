{
    "name": "@kristijorgji/postman-smoke",
    "description": "Reusable Postman collection smoke runner (ordered HTTP suite with plugins)",
    "author": "Kristi Jorgji",
    "private": true,
    "version": "0.1.0",
    "engines": {
        "node": ">=22.16.0"
    },
    "bin": {
        "postman-smoke": "./bin/postman-smoke.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "bin",
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "prepare": "husky && node scripts/sync-agent-skills.mjs && pnpm run build",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "start": "tsx -r dotenv/config src/cli.ts",
        "smoke": "tsx src/cli.ts",
        "lint": "eslint . --max-warnings 0",
        "fix": "eslint . --fix --max-warnings 0",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.eslint.json",
        "build": "tsc && tsc-alias -p tsconfig.json",
        "clean": "rimraf dist"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@kristijorgji/eslint-config-typescript": "^1.2.3",
        "@types/node": "^26.3.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "tsc-alias": "^1.9.2",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@9.15.4"
}
